# Resend (transactional email)
# Get a key at https://resend.com/api-keys. Required in production; both
# forms below return an error without it.
RESEND_API_KEY=

# --- Homepage waitlist form (app/actions.tsx) -------------------------------
# All three are required. joinWaitlist throws "Missing email configuration"
# without them, and the visitor sees a generic failure message.
# Verified sending domain the admin notification is sent FROM.
SENDER_EMAIL_NOTIFICATIONS=
# Verified sending domain the visitor's confirmation is sent FROM.
SENDER_EMAIL_WELCOME=
# Where the admin notification is delivered TO.
ADMIN_EMAIL=

# --- Daily-P&L lead magnet (app/tools/daily-pl-cheat-sheet/actions.ts) ------
# Optional. Defaults to "EasyShiftHQ <hello@easyshifthq.com>".
RESEND_FROM_EMAIL=

# PostHog (product analytics on the marketing site)
# Get a key in PostHog → Project Settings → Project API key.
# Without this, the PostHog provider no-ops and events are dropped silently.
NEXT_PUBLIC_POSTHOG_KEY=
# Optional. Defaults to https://us.i.posthog.com.
NEXT_PUBLIC_POSTHOG_HOST=
