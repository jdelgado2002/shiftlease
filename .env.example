# Resend (transactional email — used by the lead-magnet form)
# Get a key at https://resend.com/api-keys. Required in production; the
# /tools/daily-pl-cheat-sheet form will return an error without it.
RESEND_API_KEY=
# Optional. Defaults to "EasyShiftHQ <hello@easyshifthq.com>".
RESEND_FROM_EMAIL=

# PostHog (product analytics on the marketing site)
# Get a key in PostHog → Project Settings → Project API key.
# Without this, the PostHog provider no-ops and events are dropped silently.
NEXT_PUBLIC_POSTHOG_KEY=
# Optional. Defaults to https://us.i.posthog.com.
NEXT_PUBLIC_POSTHOG_HOST=
